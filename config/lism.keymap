#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ESC_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <1 0>;
        };

        TAB_combo {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        DEL_combo {
            bindings = <&kp DEL>;
            key-positions = <8 9>;
        };

        mouse {
            bindings = <&to 1>;
            key-positions = <36 37>;
        };

        japanease {
            bindings = <&kp LANG1>;
            key-positions = <35 13>;
        };

        english {
            bindings = <&kp LANG2>;
            key-positions = <36 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q             &kp W         &kp E           &kp R           &kp T                                            &kp Y           &kp U           &kp I            &kp O             &kp P
&kp A             &kp S         &kp D           &kp F           &kp G                                            &kp H           &kp J           &kp K            &kp L             &kp SEMI
&mt LEFT_SHIFT Z  &kp X         &kp C           &kp V           &kp B                                            &kp N           &kp M           &kp COMMA        &mt UP_ARROW DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT    &msc SCRL_UP    &lt 2 SPACE      &lt 3 SPACE    &lt 3 BACKSPACE  &lt 1 ENTER     &msc SCRL_UP    &kp LEFT         &kp DOWN          &lt 4 RIGHT
                                &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                                  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
                &trans  &trans  &trans                    &trans  &trans    &trans
            >;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
&kp F1    &kp F2    &kp F3     &kp F4       &kp F5                       &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp EQUAL
&kp F6    &kp F7    &kp F8     &kp F9       &kp F10                      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS      &kp MINUS
&kp F11   &kp UP    &kp F12    &kp PERCENT  &kp COLON                    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTRK     &kp SLASH
&kp LEFT  &kp DOWN  &kp RIGHT  &kp UP       &trans     &trans    &trans  &trans        &kp UP        &kp DOT       &kp CARET     &kp DOLLAR
                    &kp LEFT   &kp DOWN     &kp RIGHT                    &kp LEFT      &kp DOWN      &kp RIGHT
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
&kp LS(LG(N4))  &kp F4   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER                    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp BACKSLASH
&emoji          &kp F5   &kp LEFT_BRACKET      &kp MINUS              &kp AT                       &kp EXCL              &kp SINGLE_QUOTE       &kp DOUBLE_QUOTES  &kp DOUBLE_QUOTES  &kp BACKSLASH
&kp KP_NUMLOCK  &kp F11  &kp LEFT_BRACE        &kp RIGHT_BRACE        &none                        &kp QUESTION          &kp PERCENT            &kp CARET          &kp AMPERSAND      &kp ASTERISK
&trans          &trans   &trans                &trans                 &trans     &trans    &trans  &trans                &trans                 &none              &none              &kp F12
                         &trans                &trans                 &trans                       &trans                &trans                 &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
&none        &none           &none   &none   &bt BT_CLR                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none        &none           &none   &none   &none                                &none         &none         &none         &none         &none
&sys_reset   &none           &none   &none   &none                                &none         &none         &none         &none         &sys_reset
&bootloader  &bt BT_CLR_ALL  &none   &none   &none       &none    &studio_unlock  &none         &none         &none         &none         &bootloader
                             &trans  &trans  &trans                               &trans        &trans        &trans
            >;
        };

        layer_5 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };
    };
};
